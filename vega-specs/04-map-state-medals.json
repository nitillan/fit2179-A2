{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Australian states coloured by number of swimming medals won at Tokyo 2020, based on athlete home state from the Australian Olympic Committee Medallists document.",
  "title": "Olympic Swimming Medals by Home State — Tokyo 2020",
  "width": "container",
  "height": 340,
  "projection": {"type": "mercator"},
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "values": [
            {"state": "Queensland",                   "medals": 13},
            {"state": "New South Wales",              "medals": 5},
            {"state": "Victoria",                     "medals": 2},
            {"state": "South Australia",              "medals": 2},
            {"state": "Western Australia",            "medals": 1},
            {"state": "Tasmania",                     "medals": 1},
            {"state": "Northern Territory",           "medals": 0},
            {"state": "Australian Capital Territory", "medals": 0}
          ]
        },
        "key": "state",
        "fields": ["medals"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "#0a1628", "strokeWidth": 1},
  "encoding": {
    "color": {
      "field": "medals",
      "type": "quantitative",
      "title": "Medals (Tokyo 2020)",
      "scale": {"scheme": "blues", "domain": [0, 13]}
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "title": "State"},
      {"field": "medals", "title": "Swimming Medals"}
    ]
  }
}
