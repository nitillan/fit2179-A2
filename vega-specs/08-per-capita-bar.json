{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart comparing swimming gold medals per million population across top swimming nations. Highlights Australia's extraordinary performance relative to its small population.",
  "title": "Swimming Gold Medals Per Million Population — Top Nations",
  "width": "container",
  "height": 280,
  "data": {
    "values": [
      {"nation": "Australia",    "gpm": 3.0},
      {"nation": "E. Germany",   "gpm": 2.24},
      {"nation": "Hungary",      "gpm": 2.6},
      {"nation": "Netherlands",  "gpm": 1.06},
      {"nation": "USA",          "gpm": 0.64},
      {"nation": "Canada",       "gpm": 0.35},
      {"nation": "Great Britain","gpm": 0.26},
      {"nation": "Russia/USSR",  "gpm": 0.35},
      {"nation": "Japan",        "gpm": 0.17},
      {"nation": "China",        "gpm": 0.03}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusTopRight": 4, "cornerRadiusTopLeft": 4},
  "encoding": {
    "y": {"field": "nation", "type": "nominal", "sort": "-x", "title": "Nation"},
    "x": {"field": "gpm",    "type": "quantitative", "title": "Gold Medals Per Million Population"},
    "color": {
      "condition": {"test": "datum.nation === 'Australia'", "value": "#f4c430"},
      "value": "#1e6fa8"
    },
    "tooltip": [{"field": "nation", "title": "Nation"}, {"field": "gpm", "title": "Golds per Million"}]
  }
}
