{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart of top 10 nations by all-time Olympic swimming gold medals.",
  "title": "All-Time Olympic Swimming Gold Medals — Top 10 Nations",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      {"nation": "USA",          "gold": 217},
      {"nation": "Russia/USSR",  "gold": 51},
      {"nation": "China",        "gold": 47},
      {"nation": "E. Germany",   "gold": 38},
      {"nation": "Australia",    "gold": 78},
      {"nation": "Hungary",      "gold": 26},
      {"nation": "Japan",        "gold": 21},
      {"nation": "Netherlands",  "gold": 19},
      {"nation": "Great Britain","gold": 18},
      {"nation": "Canada",       "gold": 14}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2},
      "encoding": {
        "y": {"field": "nation", "type": "nominal", "sort": "-x", "title": "Nation"},
        "x": {"field": "gold",   "type": "quantitative", "title": "Gold Medals"},
        "x2": {"value": 0}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "y": {"field": "nation", "type": "nominal", "sort": "-x"},
        "x": {"field": "gold",   "type": "quantitative"},
        "color": {
          "condition": {"test": "datum.nation === 'Australia'", "value": "#f4c430"},
          "value": "#5bbfde"
        },
        "tooltip": [{"field": "nation", "title": "Nation"}, {"field": "gold", "title": "Gold Medals"}]
      }
    }
  ]
}
