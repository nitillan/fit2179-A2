{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap showing estimated Australian Olympic swimming medals by stroke type and event distance. Freestyle relay and sprint events have historically been most fruitful.",
  "title": "Australian Swimming Medals by Stroke and Distance (Estimated)",
  "width": "container",
  "height": 280,
  "data": {
    "values": [
      {"stroke": "Freestyle",    "dist": "50m",    "medals": 4},
      {"stroke": "Freestyle",    "dist": "100m",   "medals": 12},
      {"stroke": "Freestyle",    "dist": "200m",   "medals": 9},
      {"stroke": "Freestyle",    "dist": "400m",   "medals": 8},
      {"stroke": "Freestyle",    "dist": "800m",   "medals": 4},
      {"stroke": "Freestyle",    "dist": "1500m",  "medals": 6},
      {"stroke": "Freestyle",    "dist": "Relay",  "medals": 22},
      {"stroke": "Backstroke",   "dist": "100m",   "medals": 7},
      {"stroke": "Backstroke",   "dist": "200m",   "medals": 5},
      {"stroke": "Breaststroke", "dist": "100m",   "medals": 5},
      {"stroke": "Breaststroke", "dist": "200m",   "medals": 6},
      {"stroke": "Butterfly",    "dist": "100m",   "medals": 4},
      {"stroke": "Butterfly",    "dist": "200m",   "medals": 3},
      {"stroke": "Medley",       "dist": "200m IM","medals": 5},
      {"stroke": "Medley",       "dist": "400m IM","medals": 3},
      {"stroke": "Medley",       "dist": "Relay",  "medals": 9}
    ]
  },
  "mark": {"type": "rect", "cornerRadius": 3},
  "encoding": {
    "x": {"field": "dist",   "type": "nominal", "title": "Event",  "axis": {"labelAngle": -45}},
    "y": {"field": "stroke", "type": "nominal", "title": "Stroke"},
    "color": {
      "field": "medals", "type": "quantitative", "title": "Medals",
      "scale": {"scheme": "orangered"}
    },
    "tooltip": [
      {"field": "stroke", "title": "Stroke"},
      {"field": "dist",   "title": "Distance"},
      {"field": "medals", "title": "Medals"}
    ]
  }
